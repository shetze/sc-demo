# --- build stage: qemu-system-<arch> ---------------------------------------
# RHEL/CentOS Stream 10 only ship qemu-kvm (native arch only), and neither
# EPEL 10 nor the CentOS Virt SIG package qemu-system-*. Build them from
# source so the exporter can run VMs of a different arch than the node
# (e.g. x86_64 VMs on arm64 nodes, or the reverse). Without KVM the qemu
# driver prefers qemu-system-<arch> over the qemu-kvm TCG fallback.
FROM quay.io/centos/centos:stream10 AS qemu-build

ARG QEMU_VERSION=11.1.3 \
    QEMU_SHA256=5a8289c7940dc77d3873c81a6c29ba3afe1446fc9d36e77fa1658cdbecb84b22 \
    QEMU_TARGETS=aarch64-softmmu,x86_64-softmmu

# ninja-build, libslirp-devel and libfdt-devel live in CRB
RUN dnf install -y --setopt=tsflags=nodocs dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf install -y --setopt=tsflags=nodocs \
        gcc make ninja-build python3 xz bzip2 diffutils findutils \
        glib2-devel pixman-devel zlib-devel libslirp-devel libfdt-devel && \
    dnf -y clean all && rm -rf /var/cache/dnf

# --enable-* for what the qemu driver relies on, so a missing dependency
# fails the build instead of producing a binary without it:
# slirp (-netdev user + hostfwd), vnc (-vnc unix:), tpm (-tpmdev emulator),
# vhost-kernel (vhost-vsock), fdt (aarch64 'virt' machine).
RUN curl -fsSL -o /tmp/qemu.tar.xz "https://download.qemu.org/qemu-${QEMU_VERSION}.tar.xz" && \
    echo "${QEMU_SHA256}  /tmp/qemu.tar.xz" | sha256sum -c - && \
    mkdir /tmp/qemu && tar -xJf /tmp/qemu.tar.xz -C /tmp/qemu --strip-components=1 && \
    cd /tmp/qemu && \
    ./configure \
        --prefix=/usr/local \
        --target-list="${QEMU_TARGETS}" \
        --enable-slirp --enable-vnc --enable-tpm --enable-vhost-kernel --enable-fdt=system \
        --disable-docs --disable-user --disable-gtk --disable-sdl --disable-opengl && \
    make -j"$(nproc)" && \
    make install && \
    rm -rf /tmp/qemu /tmp/qemu.tar.xz

# --- exporter image --------------------------------------------------------
FROM ghcr.io/rhadp/runtime:latest
# see https://github.com/rhadp/containers/blob/main/containers/runtime/Containerfile

USER root

ARG TARGETARCH

# define some environment variables
ENV ARCH=${TARGETARCH:-arm64} \
    HOME=/opt/app-root/src \
    APP_ROOT=/opt/app-root \
    XDG_CONFIG_HOME=/opt/app-root/.config \
    PATH=/opt/app-root/src/bin:/opt/app-root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# set the virtual environment for jumpstarter etc
ENV UV_PYTHON=python3.14 VIRTUAL_ENV=/venv

# repo/ref providing the rhas-driver-* packages (local forks of jumpstarter drivers)
ENV JUMPSTARTER_REPO=https://github.com/mickume/jumpstarter \
    JUMPSTARTER_VERSION=develop \
    RHAS_STARTER_REPO=https://github.com/rhadp-examples/rhas-starter \
    RHAS_STARTER_VERSION=main

# install basic packages & virtualization packages
ARG CENTOS_STREAM_VERSION=10.0-23.el10 \
    FLASHER_VERSION=0.4.1

# UBI10 doesn't ship qemu-kvm/libvirt/the @virtualization-* groups, and this
# build environment has no RHEL entitlement (subscription-manager) to reach
# the real RHEL AppStream repos for them. Pull in the matching CentOS
# Stream 10 repos instead: CentOS Stream is upstream of RHEL 10, so its
# BaseOS/AppStream package and group definitions line up with what an
# entitled RHEL host would otherwise provide. EPEL is already enabled by
# the base ghcr.io/rhadp/runtime image, so it isn't touched here.
RUN if [ "$ARCH" = "arm64" ]; then \
        CENTOS_ARCH=aarch64; \
    else \
        CENTOS_ARCH=x86_64; \
    fi && \
    dnf install -y --setopt=tsflags=nodocs \
        "https://mirror.stream.centos.org/10-stream/BaseOS/${CENTOS_ARCH}/os/Packages/centos-stream-repos-${CENTOS_STREAM_VERSION}.noarch.rpm" \
        "https://mirror.stream.centos.org/10-stream/BaseOS/${CENTOS_ARCH}/os/Packages/centos-gpg-keys-${CENTOS_STREAM_VERSION}.noarch.rpm"

RUN dnf install -y --setopt=tsflags=nodocs \
    stow qemu-kvm qemu-img libvirt \
    "@virtualization-hypervisor" "@virtualization-client" "@virtualization-platform" "@virtualization-tools" \
    virt-install virt-viewer \
    genisoimage \
    swtpm swtpm-tools tpm2-tools && \
    dnf -y clean all --enablerepo='*' && \
    rm -rf /var/cache/dnf

# qemu-system-<arch> from the build stage, plus its firmware/data files
# (edk2-*.fd, SeaBIOS, option ROMs, VNC keymaps) and runtime libraries
COPY --from=qemu-build /usr/local/bin/qemu-system-* /usr/local/bin/
COPY --from=qemu-build /usr/local/share/qemu /usr/local/share/qemu
RUN dnf install -y --setopt=tsflags=nodocs glib2 pixman zlib libslirp libfdt && \
    dnf -y clean all --enablerepo='*' && \
    rm -rf /var/cache/dnf && \
    for q in /usr/local/bin/qemu-system-*; do "$q" --version; done

# install swtpm
# entrypoint.sh only runs `swtpm socket`, so only the tpmstate dir is
# needed. /var/lib/swtpm-localca is intentionally left out since nothing
# here calls swtpm_setup/swtpm_cert to provision a local CA; add it back
# (with the same chgrp/chmod treatment) if EK/platform cert provisioning
# is introduced later.
RUN mkdir -p /tmp/swtpm && \
    chgrp -R 0 /tmp/swtpm && \
    chmod -R g=u /tmp/swtpm
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Install the rhas driver packages (local forks of jumpstarter drivers) directly from GitHub, and any other patches to Jumpstarter
RUN uv venv --clear /venv && \
    uv pip install "git+${JUMPSTARTER_REPO}@${JUMPSTARTER_VERSION}#subdirectory=python/packages/jumpstarter-all" \
        "git+${RHAS_STARTER_REPO}@${RHAS_STARTER_VERSION}#subdirectory=packages/rhas-driver-qemu" \
        "git+${RHAS_STARTER_REPO}@${RHAS_STARTER_VERSION}#subdirectory=packages/rhas-driver-opendal" \
        "git+${RHAS_STARTER_REPO}@${RHAS_STARTER_VERSION}#subdirectory=packages/rhas-driver-power"

# install the Fast Flash Tool https://github.com/jumpstarter-dev/fls
RUN if [ "$ARCH" = "arm64" ]; then \
        curl -L https://github.com/jumpstarter-dev/fls/releases/download/${FLASHER_VERSION}/fls-aarch64-linux-musl -o /usr/local/bin/fls; \
    else \
        curl -L https://github.com/jumpstarter-dev/fls/releases/download/${FLASHER_VERSION}/fls-x86_64-linux -o /usr/local/bin/fls; \
    fi  && \
    chmod +x /usr/local/bin/fls

WORKDIR ${HOME}

# A last pass to make sure that an arbitrary user can write in $HOME
RUN chgrp -R 0 /home && chmod -R g=u /home

USER 1001

ENV TPM2TOOLS_TCTI="swtpm:host=127.0.0.1,port=2321"
ENTRYPOINT ["entrypoint.sh"]
CMD ["tail", "-f", "/dev/null"]